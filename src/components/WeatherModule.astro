---
import type { Locale } from '../i18n';
import { WEATHER_I18N } from '../data/weather-i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const L = WEATHER_I18N[locale];

const WEATHER_URL =
  'https://api.open-meteo.com/v1/forecast?latitude=6.9329&longitude=79.8554' +
  '&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation_probability,weather_code,wind_speed_10m,is_day' +
  '&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max' +
  '&timezone=Asia%2FColombo&forecast_days=7';

let raw: unknown = null;
try {
  const res = await fetch(WEATHER_URL, { cf: { cacheTtl: 600 } });
  if (res.ok) raw = await res.json();
} catch {
  raw = null;
}
---

<section class="mx-auto max-w-5xl px-4 py-14">
  <p class="text-xs font-semibold uppercase tracking-wide text-teal-700">{L.ui.current}</p>
  <h2 class="mt-2 text-2xl font-bold text-slate-900 md:text-3xl">{L.ui.title}</h2>
  <p class="mt-2 max-w-3xl text-slate-600">{L.ui.subtitle}</p>

  <div id="weather-root" class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-sm text-slate-500">{L.ui.loading}</p>
  </div>

  <p class="mt-3 text-[11px] text-slate-400">{L.ui.sourceNote}</p>

  <script define:vars={{ RAW: raw, LANG: L }} is:inline>
    (function () {
      const root = document.getElementById('weather-root');
      if (!root || !LANG) return;

      function beaufort(kmh) {
        const b = [0.3,1.6,3.4,5.5,8,10.8,13.9,17.2,20.8,24.5,28.5,32.7];
        for (let i = 0; i < b.length; i++) if (kmh < b[i]) return i;
        return 12;
      }
      function weekday(dateStr, lang) {
        const d = new Date(dateStr + 'T00:00:00');
        return lang.weekdays[d.getDay()];
      }
      function esc(s) {
        return String(s).replace(/[&<>"]/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));
      }
      function adviceFor(v, P) {
        const out = { clothing: [], activity: [], items: [], risk: [] };
        if (!v) return out;
        const code = v.current.weather_code;
        const prob = v.current.precipitation_probability;
        const wind = v.current.wind_speed_10m;
        const b = beaufort(wind);
        const isRain = [51,53,55,61,63,65,66,67,80,81,82].includes(code);
        const isHeavy = isRain && ([65,82].includes(code) || prob >= 80);
        const isModHeavy = isRain && !isHeavy && prob >= 50;
        const isThunder = [95,96,99].includes(code);
        const isFog = [45,48].includes(code);
        const isLight = isRain && !isHeavy && !isModHeavy;
        const isClear = code === 0;
        const isCloud = [1,2,3].includes(code);
        const tmax = v.daily.temperature_2m_max[0];
        const tmin = v.daily.temperature_2m_min[0];
        const uv = v.daily.uv_index_max[0];

        if (isLight) {
          out.clothing.push(P.lightRainClothing);
          out.activity.push(P.lightRainActivity);
          out.items.push(P.lightRainItem);
        } else if (isModHeavy) {
          out.clothing.push(P.rainUmbrella);
          out.activity.push(P.rainShelter);
          out.items.push(P.rainItem);
        }
        if (isHeavy) {
          out.risk.push(P.heavyRisk);
          out.activity.push(P.heavyActivity);
          out.items.push(P.heavyItem);
        }
        if (isThunder) {
          out.risk.push(P.thunderRisk);
          out.activity.push(P.thunderActivity);
        }
        if (isFog) {
          out.risk.push(P.fogRisk);
          out.activity.push(P.fogActivity);
          out.items.push(P.fogItem);
        }
        if (tmax >= 32) {
          out.clothing.push(P.hotClothing);
          out.activity.push(P.hotActivity);
          out.items.push(P.hotItem);
        }
        if (uv >= 5) {
          out.clothing.push(P.uvClothing);
          out.items.push(P.uvItem);
        }
        if (tmax - tmin > 8) out.clothing.push(P.tempRange);
        if (tmax <= 10) { out.clothing.push(P.coldClothing); out.items.push(P.coldItem); }
        if (b >= 7) {
          out.risk.push(P.windRisk);
          out.activity.push(P.windActivity);
        } else if (b >= 5) {
          out.clothing.push(P.windClothing);
          out.activity.push(P.windActivity);
          out.items.push(P.windItem);
        }
        if (!isRain && isClear) {
          out.activity.push(P.clearActivity);
          out.items.push(P.clearItem);
        } else if (!isRain && isCloud) {
          out.activity.push(P.cloudActivity);
        }
        return out;
      }

      function render(v, lang) {
        const P = lang.phrases;
        const w = lang.wmo[String(v.current.weather_code)] || lang.wmo['0'];
        const b = beaufort(v.current.wind_speed_10m);
        const adv = adviceFor(v, P);
        const today = lang.weekdays[new Date().getDay()];
        const cards = `
          <div class="grid gap-4 md:grid-cols-2">
            <div class="rounded-xl bg-teal-700 p-5 text-white">
              <p class="text-sm opacity-80">${esc(lang.ui.current)} · ${esc(today)}</p>
              <div class="mt-2 flex items-center gap-3">
                <span class="text-5xl">${w.icon}</span>
                <div>
                  <div class="text-3xl font-bold">${Math.round(v.current.temperature_2m)}°C</div>
                  <div class="text-sm opacity-90">${esc(w.label)}</div>
                </div>
              </div>
              <div class="mt-3 grid grid-cols-2 gap-2 text-xs opacity-90">
                <div>${esc(lang.ui.feelsLike)}: ${Math.round(v.current.apparent_temperature)}°C</div>
                <div>${esc(lang.ui.humidity)}: ${v.current.relative_humidity_2m}%</div>
                <div>${esc(lang.ui.wind)}: ${Math.round(v.current.wind_speed_10m)} km/h (${b})</div>
                <div>${esc(lang.ui.precipChance)}: ${v.current.precipitation_probability}%</div>
              </div>
            </div>
            <div class="rounded-xl border border-slate-200 p-5">
              <p class="text-sm font-semibold text-slate-700">${esc(lang.ui.week)}</p>
              <ul class="mt-2 space-y-1.5 text-sm">
                ${v.daily.time.slice(0, 7).map((t, i) => {
                  const dw = lang.wmo[String(v.daily.weather_code[i])] || lang.wmo['0'];
                  return `<li class="flex items-center justify-between">
                    <span class="text-slate-500">${esc(weekday(t, lang))}</span>
                    <span class="flex items-center gap-1">${dw.icon} ${esc(dw.label)}</span>
                    <span class="font-medium text-slate-800">${Math.round(v.daily.temperature_2m_min[i])}° / ${Math.round(v.daily.temperature_2m_max[i])}°</span>
                  </li>`;
                }).join('')}
              </ul>
            </div>
          </div>`;

        const blocks = [];
        if (adv.risk.length) blocks.push(`<div class="mt-4 rounded-xl border-l-4 border-red-400 bg-red-50 p-4"><p class="text-sm font-semibold text-red-800">${esc(lang.ui.riskTitle)}</p><ul class="mt-1 list-disc pl-5 text-sm text-red-700">${adv.risk.map((x) => `<li>${esc(x)}</li>`).join('')}</ul></div>`);
        if (adv.clothing.length) blocks.push(`<div class="mt-3 rounded-xl border border-slate-200 p-4"><p class="text-sm font-semibold text-slate-700">${esc(lang.ui.outfitTitle)}</p><ul class="mt-1 list-disc pl-5 text-sm text-slate-600">${adv.clothing.map((x) => `<li>${esc(x)}</li>`).join('')}</ul></div>`);
        if (adv.activity.length) blocks.push(`<div class="mt-3 rounded-xl border border-slate-200 p-4"><p class="text-sm font-semibold text-slate-700">${esc(lang.ui.activityTitle)}</p><ul class="mt-1 list-disc pl-5 text-sm text-slate-600">${adv.activity.map((x) => `<li>${esc(x)}</li>`).join('')}</ul></div>`);
        if (adv.items.length) blocks.push(`<div class="mt-3 rounded-xl border border-slate-200 p-4"><p class="text-sm font-semibold text-slate-700">${esc(lang.ui.itemsTitle)}</p><ul class="mt-1 list-disc pl-5 text-sm text-slate-600">${adv.items.map((x) => `<li>${esc(x)}</li>`).join('')}</ul></div>`);

        root.innerHTML = cards + blocks.join('');
      }

      function refresh() {
        fetch('/api/weather?t=' + Date.now(), { cache: 'no-store' })
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => { if (d && d.current) render(d, LANG); })
          .catch(() => {});
      }

      if (RAW && RAW.current) {
        render(RAW, LANG);
        refresh();
      } else {
        refresh();
      }
    })();
  </script>
</section>
