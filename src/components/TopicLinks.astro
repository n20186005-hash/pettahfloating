---
import { topicsByGroup, topicPath, getTopic } from '../data/topics';
import { TOPIC_UI } from '../data/topics';
import type { Locale } from '../i18n';
interface Props {
  locale: Locale;
  heading?: string;
}

const { locale, heading } = Astro.props;
const t = TOPIC_UI[locale];
const groups = topicsByGroup(locale)
  .map((g) => ({ ...g, items: g.items.filter((item) => getTopic(item.slug, locale)) }))
  .filter((g) => g.items.length > 0);
---

{groups.length > 0 && (
  <section class="mx-auto max-w-5xl px-4 py-10" id="topic-guides" aria-label="topic guides">
    <h2 class="text-2xl font-bold text-slate-900">{heading ?? 'Guides & practical topics'}</h2>
    <p class="mt-2 text-sm text-slate-500">Explore the floating market, nearby sights and planning help across {groups.length} topic groups.</p>

    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {groups.map((g) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-teal-700">{g.label}</h3>
          <ul class="mt-2 space-y-1">
            {g.items.map((item) => {
              const c = getTopic(item.slug, locale)!;
              return (
                <li>
                  <a href={topicPath(item.slug, locale)} class="text-sm text-slate-600 hover:text-teal-700 hover:underline">
                    {c.h1}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}
