---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../config';
import { SITE_NAME } from '../data/site';
import { topicPath, getTopic, type Topic, type TopicContent } from '../data/topics';
import { buildTopicWebPageSchema, buildBreadcrumbSchema, buildFaqSchema } from '../lib/schema';
import type { Locale } from '../i18n';

interface Props { locale: Locale; topic: Topic; content: TopicContent }
const { locale, topic, content } = Astro.props;
const destination: Record<string, { name: string; search: string; photo: string; source: string }> = {
  'nearby/pettah-market': { name: 'Pettah Market', search: 'Pettah Market Colombo Sri Lanka', photo: 'Pettah, Colombo.jpg', source: 'https://commons.wikimedia.org/wiki/File:Pettah,_Colombo.jpg' },
  'nearby/red-mosque': { name: 'Jami Ul-Alfar Mosque', search: 'Jami Ul Alfar Mosque Colombo Sri Lanka', photo: 'Jami ul-Alfar Mosque.jpg', source: 'https://commons.wikimedia.org/wiki/File:Jami_ul-Alfar_Mosque.jpg' },
  'nearby/khan-clock-tower': { name: 'Khan Clock Tower', search: 'Khan Clock Tower Colombo Sri Lanka', photo: 'Khan Clock Tower (5439875749).jpg', source: 'https://commons.wikimedia.org/wiki/File:Khan_Clock_Tower_(5439875749).jpg' },
  'nearby/colombo-fort': { name: 'Colombo Fort', search: 'Fort Colombo Sri Lanka', photo: 'Architecture in Fort District - Colombo - Sri Lanka - 01 (13995333126).jpg', source: 'https://commons.wikimedia.org/wiki/File:Architecture_in_Fort_District_-_Colombo_-_Sri_Lanka_-_01_(13995333126).jpg' },
  'nearby/beira-lake': { name: 'Beira Lake', search: 'Beira Lake Colombo Sri Lanka', photo: 'Beira Lake.jpg', source: 'https://commons.wikimedia.org/wiki/File:Beira_Lake.jpg' },
  'nearby/dutch-museum': { name: 'Colombo Dutch Museum', search: 'Colombo Dutch Museum Pettah Sri Lanka', photo: 'Colombo Dutch Museum.jpg', source: 'https://commons.wikimedia.org/wiki/File:Colombo_Dutch_Museum.jpg' },
  'nearby/lotus-tower': { name: 'Colombo Lotus Tower', search: 'Colombo Lotus Tower Sri Lanka', photo: 'Lotus Tower 20260216 213906 1.jpg', source: 'https://commons.wikimedia.org/wiki/File:Lotus_Tower_20260216_213906_1.jpg' },
};
const place = destination[topic.slug];
const photoUrl = `https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(place.photo)}?width=1200`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.search)}`;
const canonical = SITE_URL.replace(/\/$/, '') + topicPath(topic.slug, locale);
const crumbs = [{ name: SITE_NAME[locale], path: locale === 'en' ? '/' : `/${locale}/` }, { name: content.h1, path: topicPath(topic.slug, locale) }];
const jsonLd = [buildTopicWebPageSchema(SITE_URL, locale, canonical, content.h1, content.metaDescription), buildBreadcrumbSchema(SITE_URL, crumbs), buildFaqSchema(content.faqs)];
const labels = {
  en: { nearby: 'Colombo · Nearby attraction', visit: 'Plan your visit', map: 'View location & directions', checked: 'Content updated', related: 'Continue exploring Colombo', faq: 'Visitor questions', photo: 'Historic on-site photograph', source: 'Photo source', route: 'Explore the route', hours: 'Hours vary · check before visiting', rating: 'Latest rating on Google Maps' },
  zh: { nearby: '科伦坡 · 周边景点', visit: '游览指南', map: '查看位置与导航', checked: '内容更新', related: '继续探索科伦坡', faq: '访客常见问答', photo: '景点实拍照片（历史影像）', source: '图片来源', route: '探索游览路线', hours: '开放时间请出发前核实', rating: '最新评分见 Google Maps' },
  si: { nearby: 'කොළඹ · ආසන්න ස්ථානය', visit: 'සංචාරය සැලසුම් කරන්න', map: 'සිතියම සහ මාර්ගය', checked: 'යාවත්කාලීන', related: 'කොළඹ තවත් ස්ථාන', faq: 'නිතර අසන ප්‍රශ්න', photo: 'ස්ථානයේ ඡායාරූපය', source: 'ඡායාරූප මූලාශ්‍රය', route: 'ගමන් මාර්ගය', hours: 'වේලාවන් කලින් තහවුරු කරන්න', rating: 'Google Maps හි නවතම ඇගයීම' },
  ta: { nearby: 'கொழும்பு · அருகிலுள்ள இடம்', visit: 'வருகைத் திட்டம்', map: 'இருப்பிடம் மற்றும் வழி', checked: 'புதுப்பிப்பு', related: 'கொழும்பை மேலும் ஆராயுங்கள்', faq: 'அடிக்கடி கேட்கப்படும் கேள்விகள்', photo: 'இடத்தின் புகைப்படம்', source: 'பட மூலம்', route: 'பயண வழி', hours: 'நேரங்களை முன்கூட்டியே சரிபார்க்கவும்', rating: 'சமீபத்திய மதிப்பீடு Google Maps இல்' },
}[locale];
const relatedItems = topic.related.map(slug => { const t = getTopic(slug, locale); return t ? { title: t.h1, path: topicPath(slug, locale) } : null; }).filter((v): v is { title: string; path: string } => v !== null);
const routeIndex = content.sections.findIndex(s => /游览路线|Recommended Route|Route|ගමන්|பயண வழி/i.test(s.heading));
---

<BaseLayout locale={locale} basePath={`/${topic.slug}/`} title={content.metaTitle} description={content.metaDescription} jsonLd={jsonLd} showInlinePrivacy={false}>
  <article class="bg-[#fffaf0] text-[#173b38]">
    <section class="relative overflow-hidden bg-[#113f3e] text-white">
      <div class="pointer-events-none absolute inset-0 opacity-40" style="background:radial-gradient(circle at 85% 10%,#67b7ad 0,transparent 36%),radial-gradient(circle at 0 100%,#c85f3d 0,transparent 42%)"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-8 px-4 py-10 md:grid-cols-2 md:py-16">
        <div>
          <nav class="mb-6 text-xs text-teal-100"><a href={crumbs[0].path} class="hover:underline">{crumbs[0].name}</a> / {labels.nearby}</nav>
          <p class="mb-4 text-xs font-bold uppercase tracking-[.2em] text-[#f4b942]">{labels.nearby}</p>
          <h1 class="text-3xl font-extrabold leading-tight md:text-5xl">{content.h1}</h1>
          <p class="mt-5 max-w-xl text-base leading-8 text-teal-50">{content.lead}</p>
          <div class="mt-5 flex flex-wrap gap-2 text-xs font-medium"><a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/40 bg-white/10 px-3 py-2">★ {labels.rating} ↗</a><span class="rounded-full border border-white/40 bg-white/10 px-3 py-2">◷ {labels.hours}</span></div>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#f4b942] px-6 py-3 text-sm font-bold text-[#173b38] hover:bg-white">↗ {labels.map}</a>
            <a href="#visit-guide" class="rounded-full border border-white/60 px-6 py-3 text-sm font-semibold hover:bg-white/10">{labels.visit}</a>
          </div>
          <p class="mt-5 text-xs text-teal-100">{labels.checked}: {content.updated}</p>
        </div>
        <figure class="overflow-hidden rounded-[1.5rem] border border-white/20 bg-[#286d68] shadow-2xl">
          <img src={photoUrl} alt={`${place.name}, Colombo — historic location photograph`} class="aspect-[4/3] w-full object-cover" loading="eager" decoding="async" referrerpolicy="no-referrer" />
          <figcaption class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-xs text-teal-50"><span>{labels.photo}</span><a href={place.source} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">{labels.source} ↗</a></figcaption>
        </figure>
      </div>
    </section>

    <div id="visit-guide" class="mx-auto max-w-6xl px-4 py-12">
      <div class="mb-10 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-teal-100 bg-white p-5 shadow-sm"><p class="text-xs font-bold tracking-wider text-teal-700">01 · {labels.visit}</p><h2 class="mt-2 font-bold">{content.sections[1]?.heading}</h2><p class="mt-2 text-sm leading-7">{content.sections[1]?.bullets?.[0] || content.sections[1]?.paragraphs?.[0]}</p></div>
        <div class="rounded-2xl border border-teal-100 bg-white p-5 shadow-sm"><p class="text-xs font-bold tracking-wider text-teal-700">02 · {content.sections[5]?.heading}</p><p class="mt-3 text-sm leading-7">{content.sections[5]?.paragraphs?.[0] || content.sections[5]?.bullets?.[0]}</p></div>
        <div class="rounded-2xl border border-teal-100 bg-white p-5 shadow-sm"><p class="text-xs font-bold tracking-wider text-teal-700">03 · {content.sections[7]?.heading}</p><p class="mt-3 text-sm leading-7">{content.sections[7]?.paragraphs?.[0] || content.sections[7]?.bullets?.[0]}</p></div>
      </div>

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_17rem]">
        <div class="space-y-5">
          {content.sections.map((section, index) => (
            <section id={`section-${index}`} class="scroll-mt-24 rounded-2xl border border-[#e5e6db] bg-white p-6 shadow-sm md:p-8">
              <div class="mb-4 flex items-center gap-3"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#d9f0e9] text-sm font-extrabold text-[#286d68]">{String(index + 1).padStart(2, '0')}</span><h2 class="text-xl font-extrabold md:text-2xl">{section.heading}</h2></div>
              {section.paragraphs?.map(p => <p class="mt-3 leading-8 text-slate-700">{p}</p>)}
              {section.bullets && <ol class={`mt-4 space-y-3 ${index === routeIndex ? 'list-none' : 'list-disc pl-5'}`}>{section.bullets.map((bullet, i) => <li class={index === routeIndex ? 'flex gap-4 rounded-xl bg-[#f5faf7] p-3 leading-7' : 'pl-1 leading-7'}>{index === routeIndex && <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#286d68] text-xs font-bold text-white">{i + 1}</span>}<span>{index === routeIndex ? bullet.replace(/^\d+[.、．]\s*/, '') : bullet}</span></li>)}</ol>}
              {section.callout && <p class="mt-4 rounded-xl border-l-4 border-amber-500 bg-amber-50 p-4 text-sm leading-7 text-amber-950">{section.callout}</p>}
            </section>
          ))}
        </div>
        <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
          <div class="rounded-2xl bg-[#113f3e] p-6 text-white"><h2 class="text-lg font-bold">{place.name}</h2><p class="mt-2 text-sm leading-7 text-teal-100">Colombo, Sri Lanka</p><a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-5 block rounded-xl bg-[#f4b942] px-4 py-3 text-center text-sm font-bold text-[#173b38]">↗ {labels.map}</a></div>
          <div class="rounded-2xl border border-teal-100 bg-white p-5"><h2 class="font-bold">{labels.route}</h2><nav class="mt-4 space-y-3 text-sm">{content.sections.map((section, i) => <a href={`#section-${i}`} class="block text-teal-800 hover:underline">{section.heading}</a>)}</nav></div>
        </aside>
      </div>

      <section class="mt-10 rounded-2xl border border-teal-100 bg-white p-6 md:p-8"><h2 class="text-2xl font-extrabold">{labels.faq}</h2><div class="mt-5 grid gap-3 md:grid-cols-2">{content.faqs.map(f => <details class="rounded-xl border border-slate-200 p-4"><summary class="cursor-pointer font-semibold">{f.q}</summary><p class="mt-3 text-sm leading-7 text-slate-700">{f.a}</p></details>)}</div></section>
      <section class="mt-10 rounded-2xl bg-[#d9f0e9] p-6 md:p-8"><h2 class="text-2xl font-extrabold">{labels.related}</h2><div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{relatedItems.map(item => <a href={item.path} class="rounded-xl bg-white px-5 py-4 text-sm font-semibold text-teal-900 shadow-sm hover:bg-[#fffaf0]">{item.title} ↗</a>)}</div></section>
      <section class="mt-10 rounded-2xl bg-white p-6 md:p-8"><h2 class="text-2xl font-extrabold">{labels.map}</h2><p class="mt-2 text-slate-600">{place.name} · Colombo, Sri Lanka</p><iframe title={`${place.name} map`} src={`https://www.google.com/maps?q=${encodeURIComponent(place.search)}&output=embed`} class="mt-5 h-80 w-full rounded-xl border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block font-bold text-teal-800 underline">{labels.map} ↗</a></section>
    </div>
  </article>
</BaseLayout>
