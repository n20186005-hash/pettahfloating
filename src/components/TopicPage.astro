---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../config';
import { SITE_NAME } from '../data/site';
import { topicPath, getTopic, TOPIC_UI, type Topic, type TopicContent } from '../data/topics';
import { buildTopicWebPageSchema, buildBreadcrumbSchema, buildFaqSchema } from '../lib/schema';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  topic: Topic;
  content: TopicContent;
}

const { locale, topic, content } = Astro.props;
const t = TOPIC_UI[locale];

const canonical = SITE_URL.replace(/\/$/, '') + topicPath(topic.slug, locale);

const relatedItems = topic.related
  .map((slug) => {
    const t = getTopic(slug, locale);
    return t ? { slug, path: topicPath(slug, locale), title: t.h1 } : null;
  })
  .filter((x): x is { slug: string; path: string; title: string } => x !== null);

const crumbs = [
  { name: SITE_NAME[locale], path: locale === 'en' ? '/' : `/${locale}/` },
  { name: content.h1, path: topicPath(topic.slug, locale) },
];

const jsonLd = [
  buildTopicWebPageSchema(SITE_URL, locale, canonical, content.h1, content.metaDescription),
  buildBreadcrumbSchema(SITE_URL, crumbs),
  buildFaqSchema(content.faqs),
];
---

<BaseLayout
  locale={locale}
  basePath={topicPath(topic.slug, locale)}
  title={content.metaTitle}
  description={content.metaDescription}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <nav aria-label="breadcrumb" class="text-xs text-slate-500">
      <a href={crumbs[0].path} class="hover:text-slate-900">{crumbs[0].name}</a>
      <span class="px-1">/</span>
      <span aria-current="page">{content.h1}</span>
    </nav>

    <header class="mt-4 border-b border-slate-200 pb-6">
      <h1 class="text-3xl font-bold text-slate-900 md:text-4xl">{content.h1}</h1>
      <p class="mt-3 text-lg leading-relaxed text-slate-600">{content.lead}</p>
      <p class="mt-3 text-xs text-slate-400">{t.verify}: {content.updated}</p>
    </header>

    <div class="mt-8 space-y-8">
      {content.sections.map((section) => (
        <section>
          <h2 class="text-xl font-semibold text-slate-900">{section.heading}</h2>
          {section.paragraphs?.map((p) => <p class="mt-3 leading-relaxed text-slate-700">{p}</p>)}
          {section.bullets && (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-slate-700">
              {section.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
          {section.callout && (
            <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">{section.callout}</p>
          )}
        </section>
      ))}
    </div>

    {relatedItems.length > 0 && (
      <section class="mt-10 border-t border-slate-200 pt-6" aria-label="related">
        <h2 class="text-lg font-semibold text-slate-900">{t.related}</h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {relatedItems.map((r) => (
            <li>
              <a href={r.path} class="block rounded-lg border border-slate-200 px-4 py-3 text-sm text-teal-700 hover:border-teal-400 hover:bg-teal-50">{r.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-10 border-t border-slate-200 pt-6" aria-label="faq">
      <h2 class="text-lg font-semibold text-slate-900">{t.faq}</h2>
      <div class="mt-3 space-y-3">
        {content.faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 px-4 py-3">
            <summary class="cursor-pointer font-medium text-slate-900">{f.q}</summary>
            <p class="mt-2 leading-relaxed text-slate-700">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-10 rounded-lg bg-slate-50 px-4 py-3 text-xs leading-relaxed text-slate-500">
      {t.disclaimer}
    </p>
  </article>
</BaseLayout>
