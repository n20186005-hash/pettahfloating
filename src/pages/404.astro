---
// Self-contained 404 (no external assets). Served by the Worker when a path is not found.
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found · Pettah Floating Market</title>
    <style>
      :root { color-scheme: light; }
      body {
        margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background: #f0fdfa; color: #0f172a; padding: 1.5rem;
        font-family: "Noto Sans", "Noto Sans Sinhala", "Noto Sans Tamil", "Noto Sans SC", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      .card { text-align: center; max-width: 34rem; }
      .badge { letter-spacing: .2em; text-transform: uppercase; color: #0d9488; font-weight: 700; font-size: .75rem; }
      h1 { font-size: 2rem; margin: .75rem 0; }
      p { color: #475569; line-height: 1.65; }
      a.btn { display: inline-block; margin-top: 1.25rem; background: #0f766e; color: #fff; padding: .65rem 1.4rem; border-radius: 9999px; text-decoration: none; font-weight: 600; }
      a.btn:hover { background: #115e59; }
      .langs { margin-top: 1.5rem; font-size: .8rem; color: #64748b; }
      .langs a { color: #0f766e; text-decoration: none; padding: 0 .35rem; font-weight: 500; }
      .langs a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="card">
      <p class="badge">404</p>
      <h1>Page not found</h1>
      <p>The page you are looking for could not be found. Return to the Pettah Floating Market visitor guide.</p>
      <a class="btn" href="/">Back to home</a>
      <p class="langs">
        <a href="/">English</a> ·
        <a href="/si/">සිංහල</a> ·
        <a href="/ta/">தமிழ்</a> ·
        <a href="/zh/">中文</a>
      </p>
    </div>
  </body>
</html>
