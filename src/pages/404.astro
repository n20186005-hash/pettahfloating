---
import '../styles/global.css';
---
<!doctype html>
<html lang="si">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#113f3e" />
  <title>පිටුව හමු නොවීය</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').catch(function () {});
      });
    }
  </script>
</head>
<body class="grid min-h-screen place-items-center bg-lagoon-950 px-6 text-white">
  <main class="max-w-xl text-center"><img src="/favicon.svg" width="88" height="88" alt="" class="mx-auto mb-8" /><p class="text-sm font-black uppercase tracking-[.2em] text-sun-400">404</p><h1 class="mt-4 text-5xl font-black">මෙම පාර ජලයට ගියා වගේ.</h1><p class="mt-5 leading-7 text-lagoon-100/75">ඔබ සොයන පිටුව නොමැත.</p><a href="/" class="mt-8 inline-flex rounded-full bg-sun-400 px-6 py-3 font-black text-lagoon-950">මුල් පිටුවට යන්න</a></main>
</body>
</html>
