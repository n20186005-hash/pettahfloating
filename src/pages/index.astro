---
import '../styles/global.css';
import WeatherModule from '../components/WeatherModule.astro';

/* ------------------------------------------------------------------ *
 * Single-attraction entity binding — all site data lives in this block
 * ------------------------------------------------------------------ */
const DOMAIN_NAME = 'pettahfloating.com';
const SITE_URL = (Astro.site?.href.replace(/\/$/, '') ?? `https://${DOMAIN_NAME}`);

const ATTRACTION_FULL_NAME = 'Floating Market - Pettah';
const ATTRACTION_SHORT_NAME = 'Pettah Floating Market';
const ATTRACTION_LOCAL_NAME = 'පිටකොටුව පාවෙන වෙළඳපොළ';
const CITY_NAME = 'Colombo';
const CITY_LOCAL_NAME = 'කොළඹ';
const STATE_PROVINCE = 'Western Province';
const COUNTRY_NAME = 'Sri Lanka';
const COUNTRY_CODE_2LETTER = 'LK';
const POSTAL_CODE = '01000';
const STREET_ADDRESS = 'W E Bastian Mawatha';
const LATITUDE = 6.9329;
const LONGITUDE = 79.8554;
const MAPS_SHARE_URL = 'https://maps.app.goo.gl/tWzta29n1pzYXYG67';
const MAPS_EMBED_SRC =
  'https://www.google.com/maps?hl=si&gl=lk&output=embed&q=Floating+Market+-+Pettah%2C+W+E+Bastian+Mawatha%2C+Colombo+01000%2C+Sri+Lanka';
const NEARBY_LANDMARK_1 = 'Pettah Market';
const NEARBY_LANDMARK_2 = 'Jami Ul-Alfar Mosque';
const GOVT_TOURISM_URL = 'https://www.uda.gov.lk/floating-market.html';
const NATIONAL_TOURISM_URL = 'https://www.srilanka.travel/';
const TELEPHONE = '+94 11 287 3640';

/* Google Maps rating snapshot (rendered on the page only — never injected as Review markup) */
const GOOGLE_RATING = 3.7;
const GOOGLE_REVIEW_COUNT = 18836;
const RATING_STAR_PERCENT = (GOOGLE_RATING / 5) * 100;
const REVIEW_COUNT_LABEL = new Intl.NumberFormat('en-US').format(GOOGLE_REVIEW_COUNT);
const SYNC_PERIOD_SI = '2026 සැප්තැම්බර්';
const SYNC_PERIOD_EN = 'September 2026';
const SYNC_PERIOD_ZH = '2026 年 9 月';
const REVIEW_SOURCE_NOTE_SI =
  'Google Maps (ගූගල් සිතියම්) පරිශීලක සමාලෝචනවලින් සමමුහුර්ත කරන ලදී · සමමුහුර්ත කාලය 2026 සැප්තැම්බර් · ප්‍රකාශන හිමිකම් මුල් කර්තෘ සහ Google Maps සතුය.';
const REVIEW_SOURCE_NOTE_EN =
  'Synced from Google Maps user reviews · synced September 2026 · copyright belongs to the original authors and Google Maps.';
const REVIEW_SOURCE_NOTE_ZH = '同步自 Google 地图用户评价，同步时间 2026 年 9 月；版权归原作者与 Google 地图所有';
const RATING_SYNC_LINE_SI = `ශ්‍රේණිගත කිරීම සහ සමාලෝචන ගණන Google Maps (ගූගල් සිතියම්) පරිශීලක සමාලෝචනවලින් සමමුහුර්ත කරන ලදී · ${SYNC_PERIOD_SI}`;

const HERO_IMAGE = '/images/hero.jpg';
const heroImageAbsolute = new URL(HERO_IMAGE, `${SITE_URL}/`).href;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : `https://${DOMAIN_NAME}/`;
const pageTitle = `${ATTRACTION_FULL_NAME} (${CITY_NAME}) - Visitor Guide & Location | ${ATTRACTION_LOCAL_NAME}`;
const description = `Discover ${ATTRACTION_FULL_NAME}, the floating marketplace in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}. Location map, opening hours, tickets, nearby ${NEARBY_LANDMARK_1} and ${NEARBY_LANDMARK_2}, plus travel tips.`;
const ogTitle = `${ATTRACTION_FULL_NAME} - ${CITY_NAME} Travel Guide`;

const imageSources = [
  {
    src: '/images/pettah-floating-market-boardwalk.jpg',
    alt: `${ATTRACTION_FULL_NAME} - waterfront stalls and boardwalk in ${CITY_NAME}, ${COUNTRY_NAME}`,
    caption: 'ජලතීර වෙළඳ කුටි සහ ගමන් මාර්ගය',
    credit: 'Dan arndt · CC BY-SA 4.0',
    href: 'https://commons.wikimedia.org/wiki/File:PFM_-_01.jpg',
  },
  {
    src: '/images/pettah-floating-market-stalls.jpg',
    alt: `${ATTRACTION_FULL_NAME} - red-roofed market stalls in ${CITY_NAME}, ${COUNTRY_NAME}`,
    caption: 'රතු වහල සහිත වෙළඳ කුටි',
    credit: 'Dan arndt · CC BY-SA 4.0',
    href: 'https://commons.wikimedia.org/wiki/File:PFM_-_02.jpg',
  },
  {
    src: '/images/pettah-floating-market-waterfront.jpg',
    alt: `${ATTRACTION_SHORT_NAME} - boardwalk stretching across Beira Lake in ${CITY_NAME}`,
    caption: 'ජලතීර ගමන් පථය',
    credit: 'Azeez Abubakr · CC BY-SA 4.0',
    href: 'https://commons.wikimedia.org/wiki/File:Pettah_Floating_Market.jpg',
  },
  {
    src: HERO_IMAGE,
    alt: `${ATTRACTION_FULL_NAME} - ${CITY_NAME} floating market at sunset, ${COUNTRY_NAME}`,
    caption: 'හිරු බැස යන වේලාවේ පිටකොටුව පාවෙන වෙළඳපොළ',
    credit: 'Shanka Anuranga · CC BY-SA 4.0',
    href: 'https://commons.wikimedia.org/wiki/File:Pettah_Floating_Market_Colombo,_Sri_Lanka.jpg',
  },
];

const placeSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': `${SITE_URL}/#attraction`,
  name: ATTRACTION_FULL_NAME,
  alternateName: [
    ATTRACTION_SHORT_NAME,
    `${CITY_NAME} ${ATTRACTION_FULL_NAME}`,
    ATTRACTION_LOCAL_NAME,
  ],
  description: `Comprehensive visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`,
  url: SITE_URL,
  image: [heroImageAbsolute],
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${ATTRACTION_FULL_NAME}, ${STREET_ADDRESS}`,
    addressLocality: CITY_NAME,
    addressRegion: STATE_PROVINCE,
    postalCode: POSTAL_CODE,
    addressCountry: COUNTRY_CODE_2LETTER,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: LATITUDE,
    longitude: LONGITUDE,
  },
  hasMap: MAPS_SHARE_URL,
  telephone: TELEPHONE,
  sameAs: [MAPS_SHARE_URL, GOVT_TOURISM_URL, NATIONAL_TOURISM_URL],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '22:30',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: GOOGLE_RATING,
    ratingCount: GOOGLE_REVIEW_COUNT,
    bestRating: 5,
    worstRating: 1,
  },
};
if (canonical) placeSchema.url = canonical.replace(/\/$/, '');

const faqs = [
  {
    q: `Where is ${ATTRACTION_FULL_NAME} located?`,
    a: `${ATTRACTION_FULL_NAME} is located on ${STREET_ADDRESS}, ${CITY_NAME} ${POSTAL_CODE}, ${STATE_PROVINCE}, ${COUNTRY_NAME}, next to Beira Lake in Pettah.`,
    en: true,
  },
  {
    q: `Is ${ATTRACTION_SHORT_NAME} free to visit?`,
    a: `Yes, ${ATTRACTION_FULL_NAME} is a public space and general entry is free of charge. You only pay for food, drinks, handicrafts or other goods you buy.`,
    en: true,
  },
  {
    q: 'ඇතුල්වීමට ටිකට් පතක් අවශ්‍යද?',
    a: 'සාමාන්‍ය ප්‍රවේශය නොමිලේ ලෙස සඳහන් වේ. ඔබ මිලදී ගන්නා ආහාර, බීම, අත්කම් හෝ වෙනත් භාණ්ඩ සඳහා පමණක් වෙනම ගෙවීම සිදු වේ.',
  },
  {
    q: 'පැමිණීමට හොඳම වේලාව කුමක්ද?',
    a: 'උදෑසන සාපේක්ෂව නිස්කලංක අත්දැකීමක් ලබා දෙයි. ඡායාරූප සහ ජලතීර ආලෝකය සඳහා සවස අවසාන පැය වඩාත් සුන්දරය. වර්ෂාව සහ උණුසුම සැලකිල්ලට ගන්න.',
  },
  {
    q: 'කොපමණ වේලාවක් වෙන් කරගත යුතුද?',
    a: 'වෙළඳ කුටි, ජලතීරය සහ කෙටි ආහාර විවේකයක් සඳහා මිනිත්තු 30–60ක් සාමාන්‍යයෙන් ප්‍රමාණවත්ය. අසල්වැසි පිටකොටුව සමඟ එක් කළහොත් වැඩි කාලයක් වෙන් කරන්න.',
  },
  {
    q: 'Fort දුම්රිය ස්ථානයෙන් පැමිණිය හැකිද?',
    a: 'ඔව්. මෙම වෙළඳපොළ Fort දුම්රිය ස්ථානය සහ පිටකොටුව බස් මධ්‍යස්ථානයට ආසන්නව පිහිටා ඇති නිසා පොදු ප්‍රවාහනය ඉතා පහසු විකල්පයකි.',
  },
  {
    q: 'රථ ගාල් පහසුකම් තිබේද?',
    a: 'නාගරික සංවර්ධන අධිකාරියේ ව්‍යාපෘති තොරතුරු අනුව පාරිභෝගික සහ වෙළඳුන් සඳහා රථ ගාල් පහසුකම් සලසා ඇත. කාර්යබහුල පිටකොටුව ප්‍රදේශයේ ඉඩකඩ වෙනස් විය හැකි බැවින් පොදු ප්‍රවාහනය වඩාත් පහසු විය හැක.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const reviewTopics = [
  'ජලතීර ඇවිදීම සහ ඡායාරූප අවස්ථා',
  'කෙටි ආහාර, බීම සහ food court අත්දැකීම',
  'වෙළඳ කුටිවල විවිධත්වය සහ මිල මට්ටම්',
  'සවස කාලයේ ආලෝකය සහ ජලයේ ප්‍රතිබිම්බ',
  'කාර්යබහුල බව, රථගාල් සහ පිරිසිදුකම',
];
---
<!doctype html>
<html lang="si">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#113f3e" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={`${ATTRACTION_FULL_NAME} · ${CITY_NAME}`} />
    <meta property="og:locale" content="si_LK" />
    <meta property="og:image" content={heroImageAbsolute} />
    <meta property="og:image:alt" content={`${ATTRACTION_FULL_NAME} in ${CITY_NAME}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={heroImageAbsolute} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Pettah Floating" />

    <script type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP', { anonymize_ip: true });
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-white focus:px-4 focus:py-2">ප්‍රධාන අන්තර්ගතයට යන්න</a>

    <header class="sticky top-0 z-50 border-b border-lagoon-900/10 glass">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-3 lg:px-8">
        <a href="#top" aria-label="මුල් පිටුව" class="shrink-0">
          <img src="/logo.svg" width="310" height="68" alt={`${ATTRACTION_LOCAL_NAME} · ${ATTRACTION_FULL_NAME}`} class="h-12 w-auto" />
        </a>
        <nav aria-label="ප්‍රධාන සංචාලනය" class="hidden items-center gap-5 text-sm font-bold text-lagoon-900 lg:flex">
          <a href="#about" class="hover:text-clay-500">අත්දැකීම</a>
          <a href="#weather" class="hover:text-clay-500">කාලගුණය</a>
          <a href="#getting-here" class="hover:text-clay-500">පැමිණීම</a>
          <a href="#services" class="hover:text-clay-500">සේවා</a>
          <a href="#visit" class="hover:text-clay-500">සංචාරය</a>
          <a href="#food" class="hover:text-clay-500">ආහාර</a>
          <a href="#nearby" class="hover:text-clay-500">අසල</a>
          <a href="#seasons" class="hover:text-clay-500">සමය</a>
          <a href="#itineraries" class="hover:text-clay-500">මාර්ග</a>
          <a href="#reviews" class="hover:text-clay-500">සමාලෝචන</a>
          <a href="#map" class="hover:text-clay-500">සිතියම</a>
          <a href="#faq" class="hover:text-clay-500">ප්‍රශ්න</a>
        </nav>
        <a href={MAPS_SHARE_URL} rel="noopener noreferrer" target="_blank" class="rounded-full bg-clay-500 px-4 py-2.5 text-sm font-extrabold text-white shadow-sm transition hover:bg-clay-700">Google Maps</a>
      </div>
    </header>

    <main id="main">
      <section id="top" class="relative overflow-hidden bg-lagoon-950">
        <div class="absolute inset-0">
          <img src={imageSources[3].src} alt={imageSources[3].alt} class="h-full w-full object-cover opacity-55" fetchpriority="high" />
          <div class="absolute inset-0 bg-gradient-to-r from-lagoon-950 via-lagoon-950/75 to-lagoon-950/20"></div>
          <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-lagoon-950 to-transparent"></div>
        </div>
        <div class="relative mx-auto grid min-h-[78vh] max-w-7xl items-end gap-12 px-5 pb-14 pt-32 lg:grid-cols-[1.25fr_.75fr] lg:px-8 lg:pb-20">
          <div class="max-w-4xl">
