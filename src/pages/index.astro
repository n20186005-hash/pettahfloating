---
import '../styles/global.css';

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const pageTitle = 'පිටකොටුව පාවෙන වෙළඳපොළ | කොළඹ ජලතීර වෙළඳපොළ මාර්ගෝපදේශය';
const description = 'බේරේ වැව අසල පිටකොටුව පාවෙන වෙළඳපොළට පැමිණීම සඳහා ගමනාගමනය, විවෘත වේලාවන්, ගාස්තු, ආහාර, රථගාල් සහ අසල්වැසි ස්ථාන පිළිබඳ සංක්ෂිප්ත මාර්ගෝපදේශයක්.';

const imageSources = [
  {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/e/e5/PFM_-_01.jpg/1600px-PFM_-_01.jpg',
    alt: 'පිටකොටුව පාවෙන වෙළඳපොළේ ජලය අසල වෙළඳ කුටි සහ ගමන් මාර්ගය',
    credit: 'Dan arndt · CC BY-SA 4.0',
    href: 'https://commons.wikimedia.org/wiki/File:PFM_-_01.jpg',
  },
  {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/0/0c/PFM_-_02.jpg/1600px-PFM_-_02.jpg',
    alt: 'පිටකොටුව පාවෙන වෙළඳපොළේ රතු වහල සහිත කුටි',
    credit: 'Dan arndt · CC BY-SA 4.0',
    href: 'https://commons.wikimedia.org/wiki/File:PFM_-_02.jpg',
  },
  {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/d/db/Pettah_Floating_Market.jpg/1600px-Pettah_Floating_Market.jpg',
    alt: 'පාවෙන වෙළඳපොළේ බේරේ වැව දෙසට දිගහැරෙන ගමන් පථය',
    credit: 'Azeez Abubakr · CC BY-SA 4.0',
    href: 'https://commons.wikimedia.org/wiki/File:Pettah_Floating_Market.jpg',
  },
  {
    src: 'https://upload.wikimedia.org/wikipedia/commons/e/e8/Pettah_Floating_Market_Colombo%2C_Sri_Lanka.jpg',
    alt: 'හිරු බැස යන වේලාවේ පිටකොටුව පාවෙන වෙළඳපොළ',
    credit: 'Shanka Anuranga · CC BY-SA 4.0',
    href: 'https://commons.wikimedia.org/wiki/File:Pettah_Floating_Market_Colombo,_Sri_Lanka.jpg',
  },
];

const placeSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'පිටකොටුව පාවෙන වෙළඳපොළ',
  alternateName: 'Floating Market - Pettah',
  description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'W E Bastian Mawatha',
    addressLocality: 'Colombo',
    postalCode: '01000',
    addressCountry: 'LK',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 6.9329,
    longitude: 79.8554,
  },
  telephone: '+94 11 287 3640',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'],
      opens: '08:00',
      closes: '22:30',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 3.7,
    bestRating: 5,
  },
};
if (canonical) placeSchema.url = canonical;

const faqs = [
  {
    q: 'ඇතුල්වීමට ටිකට් පතක් අවශ්‍යද?',
    a: 'සාමාන්‍ය ප්‍රවේශය නොමිලේ ලෙස සඳහන් වේ. ඔබ මිලදී ගන්නා ආහාර, බීම, අත්කම් හෝ වෙනත් භාණ්ඩ සඳහා පමණක් වෙනම ගෙවීම සිදු වේ.',
  },
  {
    q: 'පැමිණීමට හොඳම වේලාව කුමක්ද?',
    a: 'උදෑසන සාපේක්ෂව නිස්කලංක අත්දැකීමක් ලබා දෙයි. ඡායාරූප සහ ජලතීර ආලෝකය සඳහා සවස අවසාන පැය වඩාත් සුන්දරය. වර්ෂාව සහ උණුසුම සැලකිල්ලට ගන්න.',
  },
  {
    q: 'කොපමණ වේලාවක් වෙන් කරගත යුතුද?',
    a: 'වෙළඳ කුටි, ජලතීරය සහ කෙටි ආහාර විවේකයක් සඳහා මිනිත්තු 30–60ක් සාමාන්‍යයෙන් ප්‍රමාණවත්ය. අසල්වැසි පිටකොටුව සමඟ එක් කළහොත් වැඩි කාලයක් වෙන් කරන්න.',
  },
  {
    q: 'Fort දුම්රිය ස්ථානයෙන් පැමිණිය හැකිද?',
    a: 'ඔව්. මෙම වෙළඳපොළ Fort දුම්රිය ස්ථානය සහ පිටකොටුව බස් මධ්‍යස්ථානයට ආසන්නව පිහිටා ඇති නිසා පොදු ප්‍රවාහනය ඉතා පහසු විකල්පයකි.',
  },
  {
    q: 'රථ ගාල් පහසුකම් තිබේද?',
    a: 'නාගරික සංවර්ධන අධිකාරියේ ව්‍යාපෘති තොරතුරු අනුව පාරිභෝගික සහ වෙළඳුන් සඳහා රථ ගාල් පහසුකම් සලසා ඇත. කාර්යබහුල පිටකොටුව ප්‍රදේශයේ ඉඩකඩ වෙනස් විය හැකි බැවින් පොදු ප්‍රවාහනය වඩාත් පහසු විය හැක.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<!doctype html>
<html lang="si">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#113f3e" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="si_LK" />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP', { anonymize_ip: true });
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-white focus:px-4 focus:py-2">ප්‍රධාන අන්තර්ගතයට යන්න</a>

    <header class="sticky top-0 z-50 border-b border-lagoon-900/10 glass">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-3 lg:px-8">
        <a href="#top" aria-label="මුල් පිටුව" class="shrink-0">
          <img src="/logo.svg" width="310" height="68" alt="පිටකොටුව පාවෙන වෙළඳපොළ" class="h-12 w-auto" />
        </a>
        <nav aria-label="ප්‍රධාන සංචාලනය" class="hidden items-center gap-5 text-sm font-bold text-lagoon-900 lg:flex">
          <a href="#experience" class="hover:text-clay-500">අත්දැකීම</a>
          <a href="#visit" class="hover:text-clay-500">සංචාරය</a>
          <a href="#food" class="hover:text-clay-500">ආහාර</a>
          <a href="#nearby" class="hover:text-clay-500">අසල</a>
          <a href="#map" class="hover:text-clay-500">සිතියම</a>
          <a href="#faq" class="hover:text-clay-500">ප්‍රශ්න</a>
        </nav>
        <a href="https://maps.app.goo.gl/tWzta29n1pzYXYG67" rel="noopener noreferrer" target="_blank" class="rounded-full bg-clay-500 px-4 py-2.5 text-sm font-extrabold text-white shadow-sm transition hover:bg-clay-700">Google Maps</a>
      </div>
    </header>

    <main id="main">
      <section id="top" class="relative overflow-hidden bg-lagoon-950">
        <div class="absolute inset-0">
          <img src={imageSources[3].src} alt={imageSources[3].alt} class="h-full w-full object-cover opacity-55" fetchpriority="high" />
          <div class="absolute inset-0 bg-gradient-to-r from-lagoon-950 via-lagoon-950/75 to-lagoon-950/20"></div>
          <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-lagoon-950 to-transparent"></div>
        </div>
        <div class="relative mx-auto grid min-h-[78vh] max-w-7xl items-end gap-12 px-5 pb-14 pt-32 lg:grid-cols-[1.25fr_.75fr] lg:px-8 lg:pb-20">
          <div class="max-w-4xl">
            <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-sand-100 backdrop-blur">
              <span class="h-2 w-2 rounded-full bg-sun-400"></span>
              බේරේ වැව · පිටකොටුව · කොළඹ 01
            </div>
            <h1 class="max-w-4xl text-5xl font-black leading-[1.08] tracking-tight text-white md:text-7xl">ජලය අසල නගරයේ වෙනස් රිද්මයක්.</h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-sand-100/90 md:text-xl">වෙළඳ කුටි, කුඩා ආහාර විවේක, ජලතීර පාර සහ පිටකොටුවේ නගර ශබ්දය අතර නිස්කලංක විරාමයක් — මේ තමයි පිටකොටුව පාවෙන වෙළඳපොළ.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#visit" class="rounded-full bg-sun-400 px-6 py-3 font-black text-lagoon-950 transition hover:-translate-y-0.5">සංචාරය සැලසුම් කරන්න</a>
              <a href="#map" class="rounded-full border border-white/30 bg-white/10 px-6 py-3 font-black text-white backdrop-blur transition hover:bg-white/20">සිතියම බලන්න</a>
            </div>
          </div>
          <aside class="rounded-[2rem] border border-white/15 bg-white/10 p-6 text-white backdrop-blur-lg hero-shadow">
            <p class="text-xs font-black uppercase tracking-[.22em] text-sun-400">ඉක්මන් තොරතුරු</p>
            <dl class="mt-5 grid grid-cols-2 gap-5">
              <div><dt class="text-sm text-sand-100/65">ශ්‍රේණිගත කිරීම</dt><dd class="mt-1 text-2xl font-black">3.7 / 5</dd></div>
              <div><dt class="text-sm text-sand-100/65">සාමාන්‍ය ප්‍රවේශය</dt><dd class="mt-1 text-2xl font-black">නොමිලේ</dd></div>
              <div><dt class="text-sm text-sand-100/65">වේලාව</dt><dd class="mt-1 text-lg font-black">සඳු–සෙන 08:00–22:30</dd></div>
              <div><dt class="text-sm text-sand-100/65">යෝජිත කාලය</dt><dd class="mt-1 text-lg font-black">30–60 මිනි.</dd></div>
            </dl>
            <p class="mt-5 border-t border-white/15 pt-4 text-xs leading-5 text-sand-100/65">විවෘත වේලාවන් සහ සේවා තත්ත්වය වෙනස් විය හැක. පිටත්වීමට පෙර Google Maps හෝ ස්ථානයෙන් තහවුරු කරන්න.</p>
          </aside>
        </div>
        <a href={imageSources[3].href} class="photo-credit absolute bottom-3 right-4 text-[11px] text-white/70 underline" target="_blank" rel="license noopener noreferrer">ඡායාරූපය: {imageSources[3].credit}</a>
      </section>

      <section id="experience" class="ripple-grid py-20 md:py-28">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
            <div>
              <p class="section-rule text-sm font-black uppercase tracking-[.18em] text-clay-500">ස්ථානයේ කතාව</p>
              <h2 class="mt-4 text-4xl font-black leading-tight text-lagoon-950 md:text-5xl">පිටකොටුවේ වෙළඳ ශක්තිය ජලතීරයට ගෙනා නගර අවකාශයක්.</h2>
