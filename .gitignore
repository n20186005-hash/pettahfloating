# Dependencies (never commit / upload)
node_modules/

# Build output (regenerated by `pnpm build`; Cloudflare serves ./dist)
dist/

# Astro / Vite cache
.astro/

# Wrangler / Cloudflare Workers local state
.wrangler/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local env (never commit secrets)
.env
.env.*
!.env.example

# Cloudflare deploy artifacts
.dev.vars
